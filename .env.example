# 이 파일을 .env 로 복사한 뒤 환경에 맞게 수정하세요:  cp .env.example .env
# (.env는 .gitignore에 포함되어 있어 커밋되지 않습니다)

# ── PostgreSQL ──
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nyctaxi
# docker compose의 DB를 다른 포트로 띄우고 싶을 때 (로컬에 이미 Postgres가 5432를 쓰는 경우)
# PG_PORT=5433

# ── Kafka ──
# 호스트에서 스크립트를 실행할 때는 9094(EXTERNAL 리스너)로 접속
KAFKA_BOOTSTRAP=localhost:9094
KAFKA_TOPIC=taxi-trips
KAFKA_GROUP_ID=taxi-loader
KAFKA_PARTITIONS=3

# ── 성능 설정 (tune.py가 추천하는 값을 여기에 넣는다) ──
# CSV_ENGINE=arrow           # pipeline.py 기본값. 벤치마크 0~4단계는 이 값과 상관없이 pandas로 고정
# COPY_WORKERS=8             # 병렬 COPY 연결 수 (0 = 자동)
# SPARK_LOCAL_CORES=8        # Spark가 동시에 쓰는 코어 수
# SPARK_DRIVER_MEMORY=auto   # Spark 메모리 (auto = 코어 수에 맞춰 자동)

# ── 실험용 ──
# APP_MEM_LIMIT=2g           # 컨테이너 메모리 상한 (기본: 제한 없음)
# COPY_CHUNK_ROWS=200000
# LOAD_METHOD=copy           # Airflow DAG에서 사용할 적재 방식
