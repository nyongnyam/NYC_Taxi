# 이 파일을 .env 로 복사한 뒤 환경에 맞게 수정하세요:  cp .env.example .env   (Windows: copy .env.example .env)

# ── PostgreSQL ──
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nyctaxi
# 로컬에 이미 PostgreSQL이 5432를 쓰고 있으면 docker compose의 DB 포트를 바꾼다
# PG_PORT=5433

# ── 적재 성능 ──
# 동시에 COPY할 DB 연결 수 (0 = 자동: CPU 코어 수, 최대 8). 28코어 PC에서는 16이 가장 빨랐다.
COPY_WORKERS=0
# 인덱스를 적재 후에 다시 만들지: auto(적재량이 테이블의 20% 이상일 때만) / on / off
DEFER_INDEXES=auto
# COPY_CHUNK_ROWS=200000
