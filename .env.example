# 이 파일을 .env 로 복사한 뒤 환경에 맞게 수정하세요:  cp .env.example .env
# (.env는 .gitignore에 포함되어 있어 커밋되지 않습니다)

# ── PostgreSQL ──
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nyctaxi
# docker compose의 DB를 다른 포트로 띄우고 싶을 때 (로컬에 이미 Postgres가 5432를 쓰는 경우)
# PG_PORT=5433

# ── Kafka ──
# 호스트에서 스크립트를 실행할 때는 9094(EXTERNAL 리스너)로 접속
KAFKA_BOOTSTRAP=localhost:9094
KAFKA_TOPIC=taxi-trips
KAFKA_GROUP_ID=taxi-loader
KAFKA_PARTITIONS=3

# ── 실험용 ──
# COPY_CHUNK_ROWS=200000
# APP_MEM_LIMIT=4g
# LOAD_METHOD=copy       # Airflow DAG에서 사용할 적재 방식
